{
  "name": "@jugaaadi/table",
  "version": "0.3.0",
  "description": "A world-class, spreadsheet-style data table for React built on TanStack Table v8 — editable cells, formulas, rich column types, borders/formatting, find & replace, shareable views, and a build-your-own blank sheet.",
  "license": "MIT",
  "author": "Mateen Khan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MateenKhan/table.git"
  },
  "bugs": {
    "url": "https://github.com/MateenKhan/table/issues"
  },
  "homepage": "https://table.jugaaadi.com",
  "keywords": [
    "react",
    "table",
    "spreadsheet",
    "tanstack",
    "data-grid",
    "datagrid",
    "editable",
    "formulas",
    "merge-cells",
    "cell-merge",
    "column-types",
    "csv-export",
    "find-replace",
    "formatting",
    "borders",
    "data-table",
    "react-component",
    "open-source"
  ],
  "type": "module",
  "main": "./dist/table.js",
  "module": "./dist/table.js",
  "types": "./dist/table.d.ts",
  "exports": {
    ".": {
      "types": "./dist/table.d.ts",
      "import": "./dist/table.js"
    },
    "./list": {
      "types": "./dist/list.d.ts",
      "import": "./dist/list.js"
    },
    "./style.css": "./dist/style.css",
    "./list.css": "./dist/list.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts && node -e \"require('fs').copyFileSync('src/list/list.css','dist/list.css')\"",
    "serve": "vite preview",
    "start": "vite",
    "prepack": "npm run build:lib",
    "test": "vitest run",
    "test:formula": "tsx src/formula.test.ts && tsx src/formulaPointing.test.ts && tsx src/globalSearch.test.ts && tsx src/fillSeries.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run test:formula && npm run build:lib"
  },
  "peerDependencies": {
    "@tanstack/match-sorter-utils": "^8.19.4",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.469.0",
    "lz-string": "^1.5.0",
    "react": ">=18",
    "react-colorful": "^5.8.0",
    "react-day-picker": "^9.14.0",
    "react-dom": ">=18",
    "react-dropzone": "^14.4.1"
  },
  "peerDependenciesMeta": {
    "@tanstack/match-sorter-utils": {
      "optional": true
    },
    "date-fns": {
      "optional": true
    },
    "framer-motion": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "lz-string": {
      "optional": true
    },
    "react-colorful": {
      "optional": true
    },
    "react-day-picker": {
      "optional": true
    },
    "react-dropzone": {
      "optional": true
    }
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@microsoft/api-extractor": "^7.58.12",
    "@rollup/plugin-replace": "^5.0.7",
    "@tanstack/match-sorter-utils": "^8.19.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/lz-string": "^1.3.34",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.5.4",
    "date-fns": "^4.4.0",
    "fflate": "^0.8.3",
    "framer-motion": "^12.42.2",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.469.0",
    "lz-string": "^1.5.0",
    "postcss": "^8.5.23",
    "react": "^18.3.1",
    "react-colorful": "^5.8.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.4.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "5.4.5",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^5.0.5"
  }
}
